<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <import type="android.view.View" />
        <variable
            name="vehicle"
            type="com.example.goride.data.model.Vehicle" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bianco"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@{vehicle.nome}"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@{vehicle.isEbike ? @string/cd_ebike : @string/cd_bici_classica}"
            android:textColor="@{vehicle.isEbike ? @color/arancio_ebike : @color/verde_primario}"
            android:textStyle="bold" />

        <!-- RF2.1 - visibile solo per le e-bike -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:visibility="@{vehicle.isEbike ? View.VISIBLE : View.GONE}">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.GoRide.Etichetta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dettaglio_batteria" />

                <TextView
                    android:id="@+id/valore_batteria"
                    style="@style/TextAppearance.GoRide.Valore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.GoRide.Etichetta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dettaglio_autonomia" />

                <TextView
                    android:id="@+id/valore_autonomia"
                    style="@style/TextAppearance.GoRide.Valore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="@color/grigio_chiaro" />

        <!-- RF3 - tariffe -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.GoRide.Etichetta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dettaglio_tariffa_sblocco" />

                <TextView
                    android:id="@+id/valore_sblocco"
                    style="@style/TextAppearance.GoRide.Valore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.GoRide.Etichetta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dettaglio_tariffa_minuto" />

                <TextView
                    android:id="@+id/valore_minuto"
                    style="@style/TextAppearance.GoRide.Valore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <!-- RF4 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/bottone_sblocca"
            style="@style/Widget.GoRide.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/dettaglio_sblocca" />

    </LinearLayout>
</layout>